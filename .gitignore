# Dependencies
node_modules/
.pnpm-store/

# Lockfile is intentionally not committed during the bootstrap window: the
# pnpm.overrides link: bridge encodes workspace-relative paths that don't
# resolve in a standalone checkout. Commit + switch CI to --frozen-lockfile
# once @fuaran-ui/* publishes to npm and the overrides are removed.

# Build output (dist = the playground artifact; dist-showcase = the showcase artifact)
dist/
dist-showcase/

# Phase 85 Fable host — generated artefacts. The committed source is
# fable-host/Host.fs + FableHost.fsproj; the JS bundle + .NET intermediates are
# produced by `dotnet fable` / restore and regenerated on every build.
fable-host/output/
fable-host/bin/
fable-host/obj/
fable-host/fable_modules/
fable-host/*.log

# fuaran-live (F#) app — the entirely-F#/Fable rebuild. Committed source is
# app/App.fs + FuaranLive.fsproj; the Fable JS bundle + .NET intermediates are
# generated by `dotnet fable` / restore and regenerated on every build.
app/output/
app/bin/
app/obj/
app/fable_modules/
app/*.log

# The showcase (F#) project — same generated-artefact posture as app/.
app/showcase/output/
# Fable emits JS for files LINKED into the showcase project (vendor/JsonValue,
# vendor/JsonHost, Projection) beside their Link path, outside output/ - ignore
# those generated siblings too.
app/showcase/Projection.js
app/showcase/vendor/
app/showcase/bin/
app/showcase/obj/
app/showcase/fable_modules/
app/showcase/*.log

# The conformance-gate report the showcase panel renders. Generated per deploy by
# `pnpm run conformance:report` (scripts/conformance-report.mjs) and copied into
# the artifact by Vite; a committed copy would be stale by definition, and a
# stale green is exactly what the panel exists to avoid.
public/conformance/report.generated.json

# Playwright (parity test) artefacts
test-results/
playwright-report/
tests/parity/.cache/

# TypeScript
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Vite
vite.config.ts.timestamp-*
.vite/

# Env / secrets — the BYOK key is never written to disk, but guard regardless
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.vscode-test
