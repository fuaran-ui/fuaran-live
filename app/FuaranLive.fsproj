<Project Sdk="Microsoft.NET.Sdk">

  <!--
    fuaran-live (F#) – the entirely-F#/Fable rebuild of the playground.

    Stage 1 of the migration: an Elmish app that renders the playground chrome
    as a `Fuaran.UI` tree through the F# `Fuaran.UI.Renderer` – the same renderer
    that draws the user's emitted tree. The point of fuaran-live is that the demo
    of Fuaran is *itself a Fuaran app*; this rebuild makes it one end-to-end, with
    no TypeScript shell – "built entirely in the language it promotes."

    Mirrors the self-contained fable-host project: the F# language tier is consumed
    by direct ProjectReference into the sibling ../../fuaran-dotnet checkout (the same
    workspace-checkout binding the @fuaran-ui/* link bridge uses), and the Fable
    stack versions are pinned here since this project sits outside fuaran's central
    package management. Compiled only via `dotnet fable`, never `dotnet build`.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <DefineConstants Condition="'$(Configuration)' != 'Release'">FABLE_COMPILER;DEBUG</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Release'">FABLE_COMPILER</DefineConstants>
    <!-- Feliz 3.x + Fable.Elmish are pre-F#-10-nullness libraries; the renderer
         and the fuaran samples disable nullness for the same reason. -->
    <Nullable>disable</Nullable>
    <WarningLevel>0</WarningLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- `dotnet build` is NOT a supported gate for this project, and cannot be
       made one: DefineConstants only reach this project's own sources, so the
       referenced Fuaran projects compile as plain .NET assemblies WITHOUT
       FABLE_COMPILER – their Fable-only members are #if'd out of the assembly
       and any call site here fails FS0039. `dotnet fable` recompiles the whole
       project graph from source with FABLE_COMPILER defined everywhere, which
       is why the real pipeline (scripts/fable-app.mjs) is green. Fail fast
       with the explanation instead of the misleading FS0039. Design-time
       builds (IDE/Fable project cracking) are exempt; -p:SkipFableOnlyGuard=true
       is the escape hatch. -->
  <Target Name="FableOnlyGuard" BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(SkipFableOnlyGuard)' != 'true'">
    <Error Text="FuaranLive.fsproj is Fable-only: plain `dotnet build` cannot typecheck it (referenced Fuaran projects build without FABLE_COMPILER, so their Fable-only members are absent from the .NET assemblies). Compile via `pnpm run build` / `node scripts/fable-app.mjs`, or pass -p:SkipFableOnlyGuard=true to see the raw failures." />
  </Target>

  <ItemGroup>
    <!-- The Fable-safe slice of the Ops apply engine, the canonical-JSON codec,
         the op-record/hash-chain slice and the structural tree diff now arrive as
         PACKAGES (see the PackageReference group below), not as linked sources
         from a sibling checkout.

         Why the change: this project consumes the bounded program loop
         (Fuaran.Program.Runtime), which is distributed as a package and declares
         its own Fuaran.UI.* dependencies. A ProjectReference to Fuaran.UI in this
         project SUBSTITUTES that project for the package's Fuaran.UI dependency,
         while Fable still extracts every OTHER Fuaran.UI.* package's sources into
         fable_modules/ — where Fuaran.UI is then out of scope, and the compile
         dies in the thousands of errors. Linked copies of Ops/OpStream sources
         compound it, because the package extraction brings a second definition of
         the same modules into the same compile.

         So the whole Fuaran.UI.* consumption is packaged, at ONE version, and the
         sibling checkout is no longer part of this project's compile graph. -->
    <!-- The shared brand module (palette theme + persisted light/dark
         preference) – one definition for both entries of the site (the showcase
         project links the same file). -->
    <Compile Include="shared\Brand.fs" />
    <Compile Include="Ports.fs" />
    <Compile Include="Byok.fs" />
    <Compile Include="SystemPrompt.fs" />
    <Compile Include="Session.fs" />
    <Compile Include="Panels.fs" />
    <Compile Include="Permalink.fs" />
    <Compile Include="Gallery.fs" />
    <Compile Include="Compare.fs" />
    <Compile Include="Projection.fs" />
    <Compile Include="Agent.fs" />
    <Compile Include="Ask.fs" />
    <Compile Include="Demo.fs" />
    <Compile Include="Voice.fs" />
    <Compile Include="Live.fs" />
    <Compile Include="WebRtc.fs" />
    <Compile Include="PatternBank.fs" />
    <!-- The session-free cursor core (Phase 744): the walk's canonical
         definition — path-of-ids state, DFS moves, end-stop, re-resolution.
         Depends on the typed tree + the linked Introspect traversal surface and
         nothing else, so the showcase project links the very same file (see
         showcase\Showcase.fsproj) instead of mirroring it. Compile-ordered
         ahead of every consumer. -->
    <Compile Include="navigator\Cursor.fs" />
    <Compile Include="navigator\OpLog.fs" />
    <Compile Include="navigator\PropertyEditor.fs" />
    <Compile Include="navigator\StructuralEdit.fs" />
    <Compile Include="navigator\SiteView.fs" />
    <Compile Include="navigator\A11yWalk.fs" />
    <Compile Include="navigator\Navigator.fs" />
    <Compile Include="navigator\ProjectionSync.fs" />
    <Compile Include="navigator\Refine.fs" />
    <!-- Run mode: the emission stops being a picture and becomes an app. Owns
         the wiring of the packaged bounded program loop — the dispatch gate, the
         closed default-deny effect registry, the live $state projection and the
         step journal — so App.fs holds only the toggle and the panes. -->
    <Compile Include="RunMode.fs" />
    <!-- The Console: the shipped in-page introspection surface, driven from a
         pane instead of from a DevTools global. Compile-ordered after the
         navigator because its apply path runs through the navigator's one edit
         gate rather than restating it. -->
    <Compile Include="Console.fs" />
    <!-- The opt-in anonymous session-corpus sink. Compile-ordered after the
         session (which is the whole of what it captures) and deliberately NOT
         after Byok.fs for any reason of dependency: it takes none, and the
         absence is the point — the module that builds a contribution and the
         module that holds the key stores are never in scope together. -->
    <Compile Include="Contribute.fs" />
    <!-- Phase 1628 — the render-latency measurement harness. Compiled into this
         project (rather than into a project of its own) because it renders
         through exactly the tier this project pins, and a second project would
         be a second pin able to drift from it. Nothing in the playground
         references these modules, so the playground bundle does not carry them:
         they are reached only by measure.html, an entry the shipped build does
         not emit. Ordered before App.fs, which must stay last (it ends in
         top-level Program.run expressions). -->
    <Compile Include="measure\Corpus.fs" />
    <Compile Include="measure\Timing.fs" />
    <Compile Include="measure\Baseline.fs" />
    <Compile Include="measure\Capture.fs" />
    <Compile Include="App.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Fuaran UI language tier, consumed WHOLLY as published packages at ONE
         version. Every id here is served by the public restore path (nuget.org)
         at exactly this version — checked against the registry's own index, not
         against a local feed, because this repo's CI restores anonymously and a
         pin only a maintainer's machine can resolve is a pin nobody else can use.
         A pin naming an unpublished version is not a build error either: it is
         NU1603, a warning, after which the nearest higher version is substituted
         silently — and ONE NU1603 line on msbuild's stdout kills the Fable project
         cracker outright, presenting as an unhandled exception naming nothing.

         Typed tree + the renderer (the parity-locked class vocabulary +
         reference-CSS contract), the Ops apply engine + canonical JSON codec, the
         op-record/hash-chain slice, and the structural tree diff.

         AT 0.79.0 — the version the showcase's own CI checks out the language
         tier at, so the two halves of this repo compile against one release
         rather than two. The family has twice been held BELOW the tier's head by
         a ceiling this repo did not set, both times in the same shape: the tier
         widens a member of `Action`, and the bounded program loop below — a
         separate producer on its own version line — still constructs and
         matches the narrower form in its own Fable-packed sources, which is a
         compile error this repo cannot spell around. First over
         `Action.WriteToClipboard` (held at 0.46.0 for a cycle, lifted at the
         loop's 0.2.0), then over `Action.Navigate`, widened from a bare route
         string to a (`TextSource`, `NavigateTarget`) pair at 0.78.0 and lifted
         at the loop's 0.4.0. BOTH ARE CLEAR: nothing caps the family today.
         Neither of the two releases since is a widening this project meets —
         0.78.1 was a tier fix (the renderer's resume path named a wire type its
         Fable arm never opened, so the package built for .NET and failed for
         every Fable consumer of it, this one included), and 0.79.0 widens
         records the playground constructs none of. Read the two lifts as the
         standing shape rather than as history: a lower bound is not a
         compatibility claim (see the loop's own comment below), so a tier
         widening can cap this family again at any release, and the remedy is
         always the other producer's, never a pin here. -->
    <!-- The portable AI-connector wire substrate (Phase 1698): the JsonValue /
         JsonHost canonical-JSON model, the provider contract types, and the
         IHttpTransport egress seam. `Byok.fs` expresses the three providers
         over this substrate and drives them through a browser `fetch`
         implementation of the seam.

         A PACKAGE since Phase 1698, where it was four vendored files under a
         repo-local namespace from Phase 576 until then. The fork did not go
         away - it moved to where it can be PUBLISHED, so this repo consumes the
         one public copy instead of carrying a second. The consequences for a
         reader here are the good ones: a fix to the JSON parser (the only
         untrusted-input surface in the set) arrives as a version bump rather
         than as a hand-port, and nothing in this repo has to be kept in step
         with anything by discipline.

         FOUR MODULES ARE STILL ABSENT, and the reasoning is the reasoning
         Phase 1676 recorded when it dropped them here: the transport already
         classifies a rate limit itself; retrying automatically spends the
         READER'S OWN key, and they are the only party who can weigh that; and
         an unused SSE parser means owning prompt security ports for something
         nothing runs. The published package carries the same four files this
         project did, for the same reasons, so adopting it re-introduces
         nothing.

         It moves on the PRODUCER's version line, not on the `Fuaran.UI` family
         pin below, and nothing forces the two together: this package
         references no other `Fuaran.UI.*` package and none references it. The
         number here is higher than the family's for that reason alone.

         Its dependency set is FSharp.Core plus Fable.Core, and Fable.Core is
         reached only from the parser's `#if FABLE_COMPILER` arm - which is the
         arm this project compiles. -->
    <PackageReference Include="Fuaran.UI.AiWire" Version="0.81.0" />
    <PackageReference Include="Fuaran.UI" Version="0.79.0" />
    <PackageReference Include="Fuaran.UI.Renderer" Version="0.79.0" />
    <PackageReference Include="Fuaran.UI.Ops" Version="0.79.0" />
    <PackageReference Include="Fuaran.UI.OpStream.Abstractions" Version="0.79.0" />
    <PackageReference Include="Fuaran.UI.OpStream.Replay" Version="0.79.0" />
    <!-- Pinned EXPLICITLY even though nothing here opens it: the bounded program
         loop below declares it only as a LOWER bound, so without this line NuGet
         picks that floor and Fable extracts a tier-version-skewed copy of its
         sources into the same compile as the family above — which fails on the
         first member either side widened. It is a Fuaran.UI.* package and moves
         with the family. -->
    <PackageReference Include="Fuaran.UI.ServerDriven" Version="0.79.0" />
    <!-- The bounded program loop: the client placement that runs a wire-decoded
         program tree interactively in the browser — no hand-authored update
         function, no message type, no server. A DIFFERENT producer on its own
         version line: its 0.4.0 declares Fuaran.UI.* 0.78.1 as a LOWER bound,
         which the family above now sits ABOVE, so the consumption stays
         NU1603-clean (the pins name published versions and no floor is
         substituted). A lower bound is not a compatibility claim, and 0.78.0
         was where that showed: the loop's then-published 0.2.0 declared a
         0.70.0 floor and capped the family anyway, on the `Action.Navigate`
         widening described above, until 0.4.0 adopted it. Apache-2.0,
         published on the public tier. -->
    <PackageReference Include="Fuaran.Program.Runtime" Version="0.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicit versions (matched to fuaran-dotnet/Directory.Packages.props + the
         fable-host project), since this sits outside central package management. -->
    <PackageReference Include="Fable.Core" Version="5.0" />
    <PackageReference Include="Fable.Elmish" Version="5.0.2" />
    <PackageReference Include="Fable.Elmish.React" Version="5.6" />
    <PackageReference Include="Feliz" Version="3.3.3" />
    <!-- Phase 379 – the linked Fuaran.UI.Ops/Apply.fs delegates its structural-five
         apply legs to the Fuaran.Core skeleton engine (Fuaran.Core.Ops over the UI
         NodeWitness / IdWitness from Fuaran.Core.Tree). The real Fuaran.UI.Ops.fsproj
         carries these two package refs; because this project LINKS Apply.fs rather
         than ProjectReferencing Fuaran.UI.Ops, it must carry them itself. Both are
         FSharp.Core-only + Fable-clean (source-packed under fable/), so Fable
         retranspiles the Core skeleton source in-browser. Versions matched to
         fuaran-dotnet/Directory.Packages.props. -->
    <PackageReference Include="Fuaran.Core.Tree" Version="0.21.0" />
    <PackageReference Include="Fuaran.Core.Ops" Version="0.21.0" />
    <!-- The Pattern Bank fast path runs the real Fuaran.Core signature-search
         engine (FunctionRegistry.findBySignature – the same engine powering the
         public Fuaran.UI.FastPath package). Fable-source-packed. -->
    <PackageReference Include="Fuaran.Core.Function" Version="0.21.0" />
    <!-- The linked OpRecord/StreamEntry/HashChain slice (Phase 466 panel
         provenance) delegates to the Fuaran.Core op-stream skeleton, exactly as
         the real Fuaran.UI.OpStream.Abstractions.fsproj does; same linked-not-
         referenced rationale as the Core.Tree/Ops pair above. -->
    <PackageReference Include="Fuaran.Core.OpStream" Version="0.21.0" />
  </ItemGroup>

</Project>
