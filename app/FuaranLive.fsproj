<Project Sdk="Microsoft.NET.Sdk">

  <!--
    fuaran-live (F#) – the playground, built entirely in Fuaran: an Elmish app
    that renders its own chrome as a `Fuaran.UI` tree through the F#
    `Fuaran.UI.Renderer` – the same renderer that draws the user's emitted tree.

    The language tier is consumed as PUBLISHED packages at the versions
    `Directory.Build.props` binds, one property per producer; the Fable stack
    likewise. Compiled only via `dotnet fable`, never `dotnet build`. Why each
    project here binds the tier as it does, and the history of every raise, is
    in docs/tier-pin.md.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <DefineConstants Condition="'$(Configuration)' != 'Release'">FABLE_COMPILER;DEBUG</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Release'">FABLE_COMPILER</DefineConstants>
    <!-- Feliz 3.x + Fable.Elmish are pre-F#-10-nullness libraries; the renderer
         and the fuaran samples disable nullness for the same reason. -->
    <Nullable>disable</Nullable>
    <WarningLevel>0</WarningLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- `dotnet build` is NOT a supported gate for this project, and cannot be
       made one: DefineConstants only reach this project's own sources, so the
       referenced Fuaran projects compile as plain .NET assemblies WITHOUT
       FABLE_COMPILER – their Fable-only members are #if'd out of the assembly
       and any call site here fails FS0039. `dotnet fable` recompiles the whole
       project graph from source with FABLE_COMPILER defined everywhere, which
       is why the real pipeline (scripts/fable-app.mjs) is green. Fail fast
       with the explanation instead of the misleading FS0039. Design-time
       builds (IDE/Fable project cracking) are exempt; -p:SkipFableOnlyGuard=true
       is the escape hatch. -->
  <Target Name="FableOnlyGuard" BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(SkipFableOnlyGuard)' != 'true'">
    <Error Text="FuaranLive.fsproj is Fable-only: plain `dotnet build` cannot typecheck it (referenced Fuaran projects build without FABLE_COMPILER, so their Fable-only members are absent from the .NET assemblies). Compile via `pnpm run build` / `node scripts/fable-app.mjs`, or pass -p:SkipFableOnlyGuard=true to see the raw failures." />
  </Target>

  <ItemGroup>
    <!-- The tier arrives wholly as packages, never as a ProjectReference or as
         linked sources from a sibling checkout: the bounded program loop below
         is a package declaring its own Fuaran.UI.* dependencies, and a project
         reference would substitute a project for one of them while Fable still
         extracts the rest from packages — the compile then dies in thousands of
         errors (docs/tier-pin.md). -->
    <!-- The shared brand module (palette theme + persisted light/dark
         preference) – one definition for both entries of the site (the showcase
         project links the same file). -->
    <Compile Include="shared\Brand.fs" />
    <!-- The small JS interop helpers (Phase 2081): one definition each, shared
         with the showcase project, which links the same file. -->
    <Compile Include="shared\Interop.fs" />
    <Compile Include="Ports.fs" />
    <Compile Include="Byok.fs" />
    <Compile Include="SystemPrompt.fs" />
    <Compile Include="Session.fs" />
    <Compile Include="Panels.fs" />
    <Compile Include="Permalink.fs" />
    <Compile Include="Gallery.fs" />
    <Compile Include="Compare.fs" />
    <Compile Include="Projection.fs" />
    <Compile Include="Agent.fs" />
    <Compile Include="Ask.fs" />
    <Compile Include="Demo.fs" />
    <Compile Include="Voice.fs" />
    <Compile Include="Live.fs" />
    <Compile Include="WebRtc.fs" />
    <!-- The pattern bank's engine and seed catalogues (Phase 2081): ONE
         definition, generic over the message type, which the showcase project
         links as it links navigator\Cursor.fs. PatternBank.fs is this entry's
         panel over it. -->
    <Compile Include="shared\PatternBank.fs" />
    <Compile Include="PatternBank.fs" />
    <!-- The session-free cursor core (Phase 744): the walk's canonical
         definition — path-of-ids state, DFS moves, end-stop, re-resolution.
         Depends on the typed tree + the Introspect traversal surface and
         nothing else, so the showcase project links the very same file (see
         showcase\Showcase.fsproj) instead of mirroring it. Compile-ordered
         ahead of every consumer. -->
    <Compile Include="navigator\Cursor.fs" />
    <Compile Include="navigator\OpLog.fs" />
    <Compile Include="navigator\PropertyEditor.fs" />
    <Compile Include="navigator\StructuralEdit.fs" />
    <Compile Include="navigator\SiteView.fs" />
    <Compile Include="navigator\A11yWalk.fs" />
    <Compile Include="navigator\Navigator.fs" />
    <Compile Include="navigator\ProjectionSync.fs" />
    <Compile Include="navigator\Refine.fs" />
    <!-- Run mode: the emission stops being a picture and becomes an app. Owns
         the wiring of the packaged bounded program loop — the dispatch gate, the
         closed default-deny effect registry, the live $state projection and the
         step journal — so App.fs holds only the toggle and the panes. -->
    <Compile Include="RunMode.fs" />
    <!-- The Console: the shipped in-page introspection surface, driven from a
         pane instead of from a DevTools global. Compile-ordered after the
         navigator because its apply path runs through the navigator's one edit
         gate rather than restating it. -->
    <Compile Include="Console.fs" />
    <!-- The opt-in anonymous session-corpus sink. Compile-ordered after the
         session (which is the whole of what it captures) and deliberately NOT
         after Byok.fs for any reason of dependency: it takes none, and the
         absence is the point — the module that builds a contribution and the
         module that holds the key stores are never in scope together. -->
    <Compile Include="Contribute.fs" />
    <!-- Phase 1818 — the host-fidelity preview: the current tree shown as each
         render tier the bundled fidelity manifest (fidelity/render-fidelity.json,
         byte-locked to the specification corpus by test/hostPreview.test.ts)
         declares it. -->
    <Compile Include="HostPreview.fs" />
    <!-- Phase 1628 — the render-latency measurement harness. Compiled into this
         project (rather than into a project of its own) because it renders
         through exactly the tier this project pins, and a second project would
         be a second pin able to drift from it. Nothing in the playground
         references these modules, so the playground bundle does not carry them:
         they are reached only by measure.html, an entry the shipped build does
         not emit. Ordered before App.fs, which must stay last (it ends in
         top-level Program.run expressions). -->
    <Compile Include="measure\Corpus.fs" />
    <Compile Include="measure\Timing.fs" />
    <Compile Include="measure\Baseline.fs" />
    <Compile Include="measure\Capture.fs" />
    <!-- Phase 2047 — the tool-panel disclosure whose body mounts only while open. -->
    <Compile Include="Disclosure.fs" />
    <!-- Phase 2081 — TEST-ONLY modules: the probes, scripted providers and flat
         adapters the vitest suite imports from the Fable output. Compiled here
         so they build against exactly what the app builds against; imported by
         nothing in the app, so the modules above hold only what the playground
         runs. Ordered before App.fs, which must stay last. -->
    <Compile Include="testing\AgentProbes.fs" />
    <Compile Include="testing\AskProbes.fs" />
    <Compile Include="testing\ByokProbes.fs" />
    <Compile Include="testing\ConsoleProbes.fs" />
    <Compile Include="testing\ContributeProbes.fs" />
    <Compile Include="testing\PatternBankProbes.fs" />
    <Compile Include="testing\CursorProbes.fs" />
    <Compile Include="testing\RefineProbes.fs" />
    <Compile Include="testing\GalleryProbes.fs" />
    <Compile Include="testing\WebRtcProbes.fs" />
    <Compile Include="testing\BaselineProbes.fs" />
    <Compile Include="testing\LiveProbes.fs" />
    <Compile Include="testing\CompareProbes.fs" />
    <Compile Include="testing\SessionProbes.fs" />
    <Compile Include="testing\ProjectionProbes.fs" />
    <Compile Include="testing\OpLogProbes.fs" />
    <Compile Include="testing\PropertyEditorProbes.fs" />
    <Compile Include="testing\StructuralEditProbes.fs" />
    <Compile Include="testing\SiteViewProbes.fs" />
    <Compile Include="testing\A11yWalkProbes.fs" />
    <Compile Include="App.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Fuaran UI language tier, at ONE version (FuaranUIVersion). Every id
         here must be served by the public registry at exactly that version:
         this repo's CI restores anonymously, and an unpublished pin is NU1603 (a
         warning, then a silent substitution) — one NU160x line on msbuild's
         stdout kills the Fable project cracker. test/restoreGraphPublic.test.ts
         is the lock. -->
    <!-- The portable AI-connector wire substrate (Phase 1698): the JsonValue /
         JsonHost canonical-JSON model, the provider contract types, and the
         IHttpTransport egress seam `Byok.fs` drives through a browser `fetch`.
         Released with the rest of the tier, so it reads the tier's version. -->
    <PackageReference Include="Fuaran.UI.AiWire" Version="$(FuaranUIVersion)" />
    <PackageReference Include="Fuaran.UI" Version="$(FuaranUIVersion)" />
    <PackageReference Include="Fuaran.UI.Renderer" Version="$(FuaranUIVersion)" />
    <PackageReference Include="Fuaran.UI.Ops" Version="$(FuaranUIVersion)" />
    <PackageReference Include="Fuaran.UI.OpStream.Abstractions" Version="$(FuaranUIVersion)" />
    <PackageReference Include="Fuaran.UI.OpStream.Replay" Version="$(FuaranUIVersion)" />
    <!-- Pinned EXPLICITLY even though nothing here opens it: the program loop
         declares it only as a lower bound, so without this line NuGet picks that
         floor and Fable extracts a version-skewed copy of its sources into the
         same compile as the family. -->
    <PackageReference Include="Fuaran.UI.ServerDriven" Version="$(FuaranUIVersion)" />
    <!-- The bounded program loop: a domain-generic core on its own producer's
         line (Fuaran.Program.Runtime, FuaranProgramVersion) and the UI adapter
         that instantiates it over UI trees, released with the tier
         (Fuaran.UI.Program). Open `Fuaran.UI.Program` AFTER the
         `Fuaran.Program.*` opens so the adapter's names win (see RunMode.fs). -->
    <PackageReference Include="Fuaran.Program.Runtime" Version="$(FuaranProgramVersion)" />
    <PackageReference Include="Fuaran.UI.Program" Version="$(FuaranUIVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="$(FableCoreVersion)" />
    <PackageReference Include="Fable.Elmish" Version="$(FableElmishVersion)" />
    <PackageReference Include="Fable.Elmish.React" Version="$(FableElmishReactVersion)" />
    <PackageReference Include="Feliz" Version="$(FelizVersion)" />
    <!-- The Fuaran.Core spine, at FuaranCoreVersion — which MUST equal the Core
         version the tier's nuspec declares: these are direct pins on packages
         the tier also depends on, so a lower number downgrades the tier's own
         dependency (NU1605). Tree/Ops back the navigator's structural edits,
         Function the Pattern Bank's signature search, OpStream the panel
         provenance slice. -->
    <PackageReference Include="Fuaran.Core.Tree" Version="$(FuaranCoreVersion)" />
    <PackageReference Include="Fuaran.Core.Ops" Version="$(FuaranCoreVersion)" />
    <PackageReference Include="Fuaran.Core.Function" Version="$(FuaranCoreVersion)" />
    <PackageReference Include="Fuaran.Core.OpStream" Version="$(FuaranCoreVersion)" />
  </ItemGroup>

</Project>
