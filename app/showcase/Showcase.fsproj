<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The showcase (F#) – the zero-egress half of the site.

    Every page is a Fuaran app rendered through the F# `Fuaran.UI.Renderer` – the
    site is exhibit zero for "UI as typed data". Like the playground, it takes
    the language tier as published packages at `FuaranUIVersion` (Phase 2140);
    every package version here reads ../../Directory.Build.props, and nothing
    here reaches a source tree outside this repository.
    Compiled only via `dotnet fable`, never `dotnet build`.

    A separate project from the playground (../FuaranLive.fsproj) on purpose:
    the two entries ship as separate artifacts, and this one must contain no
    provider/key machinery – its zero-egress posture is inspectable in the
    shipped files.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <DefineConstants Condition="'$(Configuration)' != 'Release'">FABLE_COMPILER;DEBUG</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Release'">FABLE_COMPILER</DefineConstants>
    <!-- Feliz 3.x + Fable.Elmish are pre-F#-10-nullness libraries; the renderer
         and the fuaran samples disable nullness for the same reason. -->
    <Nullable>disable</Nullable>
    <WarningLevel>0</WarningLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- `dotnet build` is NOT a supported gate for this project, and cannot be
       made one: the packages' .NET assemblies are compiled WITHOUT
       FABLE_COMPILER – their Fable-only members (e.g. the renderer's
       StateStore.useStateKeys React hook) are #if'd out of the assembly and
       any call site here fails FS0039. `dotnet fable` recompiles every package
       from its fable/ sources with FABLE_COMPILER defined everywhere, which
       is why the real pipeline (scripts/fable-app.mjs) is green. Fail fast
       with the explanation instead of the misleading FS0039. Design-time
       builds (IDE/Fable project cracking) are exempt; -p:SkipFableOnlyGuard=true
       is the escape hatch. -->
  <Target Name="FableOnlyGuard" BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(SkipFableOnlyGuard)' != 'true'">
    <Error Text="Showcase.fsproj is Fable-only: plain `dotnet build` cannot typecheck it (the Fuaran packages' .NET assemblies are built without FABLE_COMPILER, so their Fable-only members are absent from them). Compile via `pnpm run build:showcase` / `node scripts/fable-app.mjs`, or pass -p:SkipFableOnlyGuard=true to see the raw FS0039 failures." />
  </Target>

  <ItemGroup>
    <!-- The shared brand module (palette theme + persisted light/dark
         preference) – one definition for both entries of the site. -->
    <Compile Include="..\shared\Brand.fs">
      <Link>shared\Brand.fs</Link>
    </Compile>
    <!-- The small JS interop helpers (Phase 2081) - one definition each, shared
         with the playground. No key, no provider origin: its one network helper
         reads a same-origin artefact as text. -->
    <Compile Include="..\shared\Interop.fs">
      <Link>shared\Interop.fs</Link>
    </Compile>
    <!-- The multi-language source projector (Attesor's engine). The PURE JSON
         model it walks arrives as a package now (see the PackageReference
         below) rather than as two linked files from a repo-local vendor
         directory - Phase 1698 published that substrate.

         The no-key-egress guarantee is UNAFFECTED, and it is worth saying why
         rather than asserting it, because the mechanism changed. It used to
         rest on which two of four vendored files this entry chose to compile.
         It now rests on something stronger: the package contains no egress
         code AT ALL. Its transport member is an interface with no
         implementation - a seam a host fills, and this entry fills nothing -
         and its provider contract is value types. The only code in this repo
         that opens a connection is the playground's browser `fetch`
         implementation, which this project does not compile. -->
    <Compile Include="..\Projection.fs">
      <Link>Projection.fs</Link>
    </Compile>
    <!-- The session-free cursor core (Phase 744) – the ONE definition of the
         walk over a Fuaran tree, shared with the playground's Navigator tab.
         It depends on the typed tree + the Introspect traversal surface and
         nothing else (no key store, no effect ports, no session), which is
         exactly what lets this zero-egress entry link it rather than mirror
         it – the drift class the Navigator page used to carry. -->
    <Compile Include="..\navigator\Cursor.fs">
      <Link>navigator\Cursor.fs</Link>
    </Compile>
    <!-- The pattern bank (Phase 2081) – the ONE definition of its engine and
         seed catalogues, shared with the playground's pattern-bank panel. -->
    <Compile Include="..\shared\PatternBank.fs">
      <Link>shared\PatternBank.fs</Link>
    </Compile>
    <Compile Include="Pillars.fs" />
    <!-- The shared page frame (title / lede / body / honesty), the wire drawer
         and the two render seams every page is built out of. Compiled ahead of
         every page that uses it. -->
    <Compile Include="Exhibit.fs" />
    <!-- The CI conformance panel - shell chrome, not a page. -->
    <Compile Include="Conformance.fs" />
    <!-- Every page file: one capability page each (plus the Evaluation and
         Contact destinations). The glob is the point - adding a page is one
         file here and one entry in Registry.fs, never a third edit. Pages are
         independent of one another, so the glob's alphabetical order is a valid
         compile order; the files named in Exclude are the shell, compiled
         explicitly around it. -->
    <Compile Include="*.fs" Exclude="Pillars.fs;Exhibit.fs;Conformance.fs;Registry.fs;Pages.fs;App.fs;Receiver.fs" />
    <!-- Test-only probes (headless surfaces the vitest suite imports). They read
         the pages above and nothing reads them, so they sit after the pages and
         before the registry; the page glob does not reach this folder. -->
    <Compile Include="testing\AgentReadableProbes.fs" />
    <Compile Include="testing\TeleportProbes.fs" />
    <Compile Include="testing\TimeMachineProbes.fs" />
    <Compile Include="testing\DataInTheInterfaceProbes.fs" />
    <Compile Include="testing\UndoGridProbes.fs" />
    <!-- The page registry: after the pages, because it names each page's value;
         it loads each one as its own chunk. -->
    <Compile Include="Registry.fs" />
    <Compile Include="Pages.fs" />
    <Compile Include="App.fs" />
    <!-- The bare teleport receiver - its own entry (receiver.html). -->
    <Compile Include="Receiver.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The language tier, as published packages at the one tier version
         (Phase 2140; the showcase was source-bound until the merge engine
         below shipped its fable/ sources - docs/tier-pin.md has the history). -->
    <PackageReference Include="Fuaran.UI" Version="$(FuaranUIVersion)" />
    <PackageReference Include="Fuaran.UI.Renderer" Version="$(FuaranUIVersion)" />
    <!-- Rosetta's F# host: the canonical encoder + the Fable-safe SHA-256. -->
    <PackageReference Include="Fuaran.UI.OpStream.Abstractions" Version="$(FuaranUIVersion)" />
    <!-- Infinite Skins' contrast auditor (the manifest-free WCAG derivation). -->
    <PackageReference Include="Fuaran.UI.StyleObserver.Abstractions" Version="$(FuaranUIVersion)" />
    <!-- Kintsugi's "senses" panel (the manifest-free overflow derivation). -->
    <PackageReference Include="Fuaran.UI.LayoutObserver.Abstractions" Version="$(FuaranUIVersion)" />
    <!-- Git for Interfaces: TreeMerge.merge3Way / merge3WayWithAuthor, run in
         the browser from the package's fable/ sources (Phase 2139). -->
    <PackageReference Include="Fuaran.UI.OpStream.Dag.Merge" Version="$(FuaranUIVersion)" />
    <!-- The Undo Grid: the grid edit log (GridEditLog / GridEdit, Phase 1891),
         whose undo, redo and hash-chained record the page draws on. Already
         compiled by the playground; Fable-source-packed. -->
    <PackageReference Include="Fuaran.UI.ServerDriven" Version="$(FuaranUIVersion)" />
    <!-- The Pattern Bank's signature search and the Versioning Envelope page's
         negotiation substrate. Fable-source-packed; at FuaranCoreVersion, the
         Core version the tier declares. -->
    <PackageReference Include="Fuaran.Core.Function" Version="$(FuaranCoreVersion)" />
    <PackageReference Include="Fuaran.Core.Wire" Version="$(FuaranCoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The portable AI-connector wire substrate the source projector walks
         (Phase 1698). Released with the tier, so it reads the tier's version -
         the same package, at the same version, that the playground compiles
         Projection.fs against. It carries no egress code (see the note above
         the projector's Compile entry). -->
    <PackageReference Include="Fuaran.UI.AiWire" Version="$(FuaranUIVersion)" />
    <PackageReference Include="Fable.Core" Version="$(FableCoreVersion)" />
    <PackageReference Include="Fable.Elmish" Version="$(FableElmishVersion)" />
    <PackageReference Include="Fable.Elmish.React" Version="$(FableElmishReactVersion)" />
    <PackageReference Include="Feliz" Version="$(FelizVersion)" />
  </ItemGroup>

</Project>
