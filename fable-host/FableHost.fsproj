<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 85 – fuaran-live F# (Fable) render host.

    Fable-compiles a tiny browser entry (Host.fs) that decodes canonical
    wire-format JSON and renders the resulting Fuaran.UI tree through the F#
    `Fuaran.UI.Renderer`. Loaded inside an iframe by the preview pane's
    host-switch; the same wire JSON also renders through the TS
    `@fuaran-ui/renderer` in a sibling iframe, proving behavioural parity
    between the two conformant hosts. QueryPortalBridge.fs exports the typed
    query core to the TS shell from the same compile.

    The language tier is consumed as PUBLISHED packages at the one version
    `Directory.Build.props` binds (Phase 2079), exactly as the playground
    consumes it, so both sides of the parity view are what a stranger can
    restore. Compiled only via `dotnet fable`, never `dotnet build`. Why each
    project binds the tier as it does is in docs/tier-pin.md.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <DefineConstants Condition="'$(Configuration)' != 'Release'">FABLE_COMPILER;DEBUG</DefineConstants>
    <DefineConstants Condition="'$(Configuration)' == 'Release'">FABLE_COMPILER</DefineConstants>
    <!-- Feliz 3.x + Fable.React are pre-F#-10-nullness libraries; the renderer
         disables nullness for the same reason. -->
    <Nullable>disable</Nullable>
    <WarningLevel>0</WarningLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Phase 324/325 – the typed-data core bridge: exports Fuaran.UI.QueryBinding
         / RetrievalSource to the TS shell as callable JS (string/JSON boundary).
         A pure function module (no Program.run), so importing its Fable output
         runs no Elmish boot. Ordered BEFORE Host.fs: Host.fs ends with top-level
         `Program.run` expressions and so must remain the last compiled file. -->
    <Compile Include="QueryPortalBridge.fs" />
    <Compile Include="Host.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Typed tree + the renderer (the parity-locked class vocabulary +
         reference-CSS contract), the canonical wire decoder (Fuaran.UI.Ops) and
         the canonical encoder (Fuaran.UI.OpStream.Abstractions). -->
    <PackageReference Include="Fuaran.UI" Version="$(FuaranUIVersion)" />
    <PackageReference Include="Fuaran.UI.Renderer" Version="$(FuaranUIVersion)" />
    <PackageReference Include="Fuaran.UI.Ops" Version="$(FuaranUIVersion)" />
    <PackageReference Include="Fuaran.UI.OpStream.Abstractions" Version="$(FuaranUIVersion)" />
    <PackageReference Include="Fable.Core" Version="$(FableCoreVersion)" />
    <PackageReference Include="Fable.Elmish" Version="$(FableElmishVersion)" />
    <PackageReference Include="Fable.Elmish.React" Version="$(FableElmishReactVersion)" />
    <PackageReference Include="Feliz" Version="$(FelizVersion)" />
  </ItemGroup>

</Project>
