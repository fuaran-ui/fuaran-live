{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.{js,css,json,ico,png,svg,jpg,jpeg,webp,gif,woff,woff2,ttf,map,txt,xml}"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
